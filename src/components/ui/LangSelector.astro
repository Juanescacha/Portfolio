---
import { languages } from "@/data"

const languageEntries = Object.entries(languages)
---

<nav
	aria-label="{ui.ally.languageSelector}"
	class="flex flex-wrap order-2 lg:order-2 gap-2 items-center max-w-md"
>
	{languageEntries.map(([locale, language], index) => (
			<>
				<a
						href={locale === 'en' ? "/" : `/${locale}`}
						aria-current={Astro.currentLocale === locale ? "page" : undefined}
						hreflang={locale}
						class={`${
							Astro.currentLocale === locale
								? "text-primary"
								: "text-muted hover:text-primary focus-visible:text-primary"
						} text-sm font-bold uppercase tracking-widest`}
				>
					{language}
				</a>
				{index !== languageEntries.length - 1 && (
						<span aria-hidden="true" class="font-medium">|</span>
				)}
			</>
	))}
</nav>
