---
import { Icon } from "astro-icon/components"
import { getContent } from "@/data"

const { ui } = getContent(Astro.currentLocale)
---

<script>
function setupThemeToggle() {
	const button = document.querySelector<HTMLButtonElement>("#theme-toggle")

	if (!button) return

	// Avoids adding the listener multiple times.
	if (button.dataset.themeReady === "true") return

	button.dataset.themeReady = "true"

	const root = document.documentElement

	button.addEventListener("click", async () => {
		// avoids multiple simultaneous animations if the user double click
		if (button.dataset.animating === "true") {
			return
		}

		const isCurrentlyDark = root.classList.contains("dark")

		const nextTheme = isCurrentlyDark ? "light" : "dark"

		const willBeDark = nextTheme === "dark"

		// modify web theme
		const applyTheme = () => {
			root.classList.toggle("dark", willBeDark)

			try {
				localStorage.setItem("theme", nextTheme)
			} catch {
				// localStorage may not be available
			}
		}

		// Respect prefers-reduced-motion.
		const prefersReducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches

		// FALLBACK : If the browser doesn't support View Transitions API
		if (!document.startViewTransition || prefersReducedMotion) {
			applyTheme()

			root.classList.toggle("scheme-light", !willBeDark)
			root.classList.toggle("scheme-dark", willBeDark)

			return
		}

		// Calculate the center of the button for circle origin
		const rect = button.getBoundingClientRect()

		const x = rect.left + rect.width / 2

		const y = rect.top + rect.height / 2

		// Calculate the radius of the circle to cover the entire viewport
		const radius = Math.hypot(
			Math.max(x, window.innerWidth - x),
			Math.max(y, window.innerHeight - y),
		)
		// const radius = Math.max(x, window.innerWidth - x)

		button.dataset.animating = "true"

		// Disable transition-colors and other CSS transitions during the change.
		root.classList.add("theme-switching")

		// 1. The browser takes a snapshot of the current state.
		// 2. We execute applyTheme().
		// 3. The browser takes a snapshot of the new state.

		const transition = document.startViewTransition(() => {
			applyTheme()
		})

		try {
			// Wait for the transition to be ready before starting the animation
			await transition.ready

			// Animate only the new view with a circular expanding from (0 to radius) at the button's center
			root.animate(
				{
					clipPath: [
						`circle(0px at ${x}px ${y}px)`,

						`circle(${radius}px at ${x}px ${y}px)`,
					],
				},
				{
					duration: 400,

					easing: "cubic-bezier(0.76, 0, 1, 1)",

					pseudoElement: "::view-transition-new(root)",
				},
			)

			await transition.finished
		} catch {
			// if something fails in the animation, the theme will have changed anyway.
		} finally {
			root.classList.toggle("scheme-light", !willBeDark)
			root.classList.toggle("scheme-dark", willBeDark)
			root.classList.remove("theme-switching")
			delete button.dataset.animating
		}
	})
}

setupThemeToggle()
</script>

<button
	id="theme-toggle"
	type="button"
	aria-label={ui.ally.changeTheme}
	aria-pressed="false"
	class="flex order-3 lg:order-1 size-6 items-center justify-center rounded-lg text-primary transition-all cursor-pointer font-black drop-shadow-transparent hover:text-accent duration-200 ease-in-out drop-shadow-lg hover:drop-shadow-white/30 hover:bg-white/0"
>
	<Icon name="ant-design:moon-filled" class="size-6 dark:hidden" />
	<Icon name="ant-design:sun-filled" class="size-6 hidden dark:inline" />
</button>
