---
import schemaEn from "@/data/schema-en.json"
import schemaEs from "@/data/schema-es.json"
import "@/styles/global.css"
import { Font } from "astro:assets"
import Analytics from "@vercel/analytics/astro"
import SpeedInsights from "@vercel/speed-insights/astro"
import About from "@/components/sections/About.astro"
import Blogs from "@/components/sections/Blogs.astro"
import Certificates from "@/components/sections/Certificates.astro"
import Experience from "@/components/sections/Experience.astro"
import Footer from "@/components/sections/Footer.astro"
import Header from "@/components/sections/Header.astro"
import Projects from "@/components/sections/Projects.astro"
import BackToTop from "@/components/ui/BackToTop.astro"
import Mouse from "@/components/ui/Mouse.astro"
import MouseTooltip from "@/components/ui/MouseTooltip.astro"
import { getContent } from "@/data"

const { profile, ui } = getContent(Astro.currentLocale)

const schema = Astro.currentLocale === "es" ? schemaEs : schemaEn
---

<!DOCTYPE html>
<html lang={Astro.currentLocale}>
	<head>
		<script is:inline>
		const storedTheme = localStorage.getItem("theme")

		const systemPrefersDark = window.matchMedia(
			"(prefers-color-scheme: dark)",
		).matches

		const shouldUseDark =
			storedTheme === "dark" || (!storedTheme && systemPrefersDark)

		document.documentElement.classList.toggle("dark", shouldUseDark)
		document.documentElement.classList.toggle("scheme-light", !shouldUseDark)
		document.documentElement.classList.toggle("scheme-dark", shouldUseDark)
		</script>

		<!-- SEO — -->
		<title>{profile.name} | {profile.role}</title>
		<meta charset="UTF-8">
		<meta name="robots" content="index, follow">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="generator" content={Astro.generator}>
		<meta name="description" content={profile.bio}>
		<meta name="author" content={profile.name}>
		<link rel="describedby" href="/llms.txt">
		<link rel="llms" href="/llms.txt" type="text/plain">
		<link
			rel="alternate"
			type="text/markdown"
			title="Compatible LLM Version"
			href="/llms.txt"
		>

		<!-- Open Graph -->
		<meta property="og:title" content={`${profile.name} | ${profile.role}`}>
		<meta property="og:description" content={profile.bio}>
		<meta property="og:url" content={ui.ally.canonicalUrl}>
		<meta property="og:image" content="https://juanescacha.dev/og.png">
		<meta property="og:image:width" content="2400">
		<meta property="og:image:height" content="1260">
		<meta property="og:type" content="website">
		<meta property="og:site_name" content={profile.name}>
		<meta property="og:locale" content={Astro.currentLocale}>

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content={`${profile.name} | ${profile.role}`}>
		<meta name="twitter:description" content={profile.bio}>
		<meta name="twitter:url" content={ui.ally.canonicalUrl}>
		<meta name="twitter:image" content="https://juanescacha.dev/og.png">

		<!-- Styles, Fonts and Assets -->
		<Font cssVariable="--font-inter" preload />
		<link
			rel="icon"
			type="image/png"
			href="https://juanescacha.dev/favicon-96x96.png"
			sizes="96x96"
		>
		<link
			rel="icon"
			type="image/svg+xml"
			href="https://juanescacha.dev/favicon.svg"
		>
		<link rel="shortcut icon" href="https://juanescacha.dev/favicon.ico">
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="https://juanescacha.dev/apple-touch-icon.png"
		>
		<meta name="apple-mobile-web-app-title" content="Juanescacha">
		<link rel="manifest" href="https://juanescacha.dev/site.webmanifest">
		<link rel="canonical" href={ui.ally.canonicalUrl}>
		<link rel="alternate" hreflang="en" href="https://juanescacha.dev/">
		<link rel="alternate" hreflang="es" href="https://juanescacha.dev/es/">
		<link rel="alternate" hreflang="x-default" href="https://juanescacha.dev/">

		<!-- Theme color -->
		<meta
			name="theme-color"
			content="#F8FAFC"
			media="(prefers-color-scheme: light)"
		>

		<meta
			name="theme-color"
			content="#161D2F"
			media="(prefers-color-scheme: dark)"
		>
		<script set:html={JSON.stringify(schema)} type="application/ld+json" />
		<Analytics />
		<SpeedInsights />
	</head>
	<body
		class="bg-background text-foreground antialiased selection:bg-accent selection:text-accent-fg leading-relaxed font-sans"
	>
		<Mouse />
		<MouseTooltip />
		<BackToTop />
		<!--border shadow-->
		<div
			class="pointer-events-none bg-linear-to-b from-transparent to-background from-80% to-99% fixed inset-0 z-40"
		/>
		<div
			class="mx-auto min-h-screen max-w-7xl px-6 md:px-12 py-12 md:py-16 lg:py-0"
		>
			<div class="lg:flex lg:justify-between lg:gap-4">
				<Header />
				<main id="content" class="pt-24 lg:w-[52%] lg:py-24">
					<About />
					<Experience />
					<Projects />
					<Certificates />
					<Blogs />
					<Footer />
				</main>
			</div>
		</div>
	</body>
</html>
