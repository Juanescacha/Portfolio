---
import "@/styles/global.css"
import { Font } from "astro:assets"
import About from "@/components/sections/About.astro"
import Experience from "@/components/sections/Experience.astro"
import Footer from "@/components/sections/Footer.astro"
import Header from "@/components/sections/Header.astro"
import Projects from "@/components/sections/Projects.astro"
import BackToTop from "@/components/ui/BackToTop.astro"
import Mouse from "@/components/ui/Mouse.astro"
import { getContent } from "@/data"

const { profile, ui } = getContent(Astro.currentLocale)
---

<!DOCTYPE html>
<html lang={Astro.currentLocale}>
	<head>
		<script is:inline>
		const storedTheme = localStorage.getItem("theme")

		const systemPrefersDark = window.matchMedia(
			"(prefers-color-scheme: dark)",
		).matches

		const shouldUseDark =
			storedTheme === "dark" || (!storedTheme && systemPrefersDark)

		document.documentElement.classList.toggle("dark", shouldUseDark)
		document.documentElement.classList.toggle("scheme-light", !shouldUseDark)
		document.documentElement.classList.toggle("scheme-dark", shouldUseDark)
		</script>

		<!-- SEO -->
		<title>{profile.name} — {profile.role}</title>
		<meta charset="utf-8">
		<meta name="robots" content="noindex, nofollow">
		<meta name="viewport" content="width=device-width">
		<meta name="generator" content={Astro.generator}>
		<meta name="description" content={profile.bio}>

		<!-- Open Graph -->
		<!--<meta property="og:title" content={title} />-->
		<!--<meta property="og:description" content={description} />-->
		<!--<meta property="og:url" content={canonicalURL} />-->
		<!--<meta property="og:image" content={imageURL} />-->
		<!--<meta property="og:type" content={type} />-->

		<!-- Twitter / X -->
		<!--<meta name="twitter:card" content="summary_large_image" />-->
		<!--<meta name="twitter:title" content={title} />-->
		<!--<meta name="twitter:description" content={description} />-->
		<!--<meta name="twitter:image" content={imageURL} />-->

		<!-- Styles, Fonts and Assets -->
		<Font cssVariable="--font-inter" preload />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg">
		<link rel="icon" href="/favicon.ico">
		<!--<link rel="canonical" href={ui.ally.canonicalUrl}>-->
		<!--<link rel="alternate" hreflang="en" href="https://juanescacha.dev/">-->
		<!--<link rel="alternate" hreflang="es" href="https://juanescacha.dev/es/">-->
		<!--<link rel="alternate" hreflang="x-default" href="https://juanescacha.dev/" />-->
	</head>
	<body
		class="bg-background text-foreground antialiased selection:bg-accent selection:text-accent-fg leading-relaxed font-sans"
	>
		<Mouse />
		<BackToTop />
		<!--border shadow-->
		<div
			class="pointer-events-none bg-linear-to-b from-transparent to-background from-80% to-99% fixed inset-0 z-40"
		/>
		<div
			class="mx-auto min-h-screen max-w-7xl px-6 md:px-12 py-12 md:py-16 lg:py-0"
		>
			<div class="lg:flex lg:justify-between lg:gap-4">
				<Header />
				<main id="content" class="pt-24 lg:w-[52%] lg:py-24">
					<About />
					<Experience />
					<Projects />
					<Footer />
				</main>
			</div>
		</div>
	</body>
</html>
