---
import { Image } from "astro:assets"
import Section from "@/components/sections/Section.astro"
import Arrow from "@/components/ui/Arrow.astro"
import { getContent } from "@/data"

const { blogs, sections, ui } = getContent(Astro.currentLocale)
---

<Section title={sections.blogs} ariaLabel={ui.ally.selectedBlogs}>
	<ul class="group/list">
		{blogs.map((blog) => (
				<li class="mb-12">
					<div
							class="group relative grid gap-4 pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:hover:opacity-100! lg:group-hover/list:opacity-50 sm:items-center"
					>
						<div
								class="absolute -inset-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-surface lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] lg:group-hover:drop-shadow-lg"
						/>
						<div class="z-10 sm:order-2 sm:col-span-6">
							<p class="text-sm mt-2 leading-normal text-foreground">{blog.date.year}</p>
							<h3>
								<a
										href={blog.url}
										target="_blank"
										rel="noreferrer noopener"
										aria-label={`${blog.title} (${ui.ally.opensInNewTab})`}
										class="inline-block items-baseline font-medium leading-tight text-primary group/link text-base"
								>
								<span
										class="absolute -inset-x-4 -inset-y-2.5 hidden rounded md:-inset-x-6 md:-inset-y-4 lg:block"
								/>
									{blog.title} <Arrow />
								</a>
							</h3>
						</div>
						<Image
								src={blog.imgSrc}
								alt={blog.title}
								sizes="(min-width: 1024px) 135px, (min-width: 640px) 215px, calc(100vw - 48px)"
								widths={[135,160, 215, 270, 405, 430, 640, 768, 960, 1200, 1536, 1858]}
								layout="constrained"
								class="aspect-video object-cover rounded border-2 border-border transition group-hover:border-border-strong sm:order-1 sm:col-span-2 sm:translate-y-1"
						/>
					</div>
				</li>
		))}
	</ul>
</Section>
