---
import Section from "@/components/sections/Section.astro"
import Arrow from "@/components/ui/Arrow.astro"
import { projects, sections } from "@/data"
---

<Section title={sections.projects} ariaLabel="Selected Projects">
	<ul class="group/list">
		{projects.map((project) => (
			<li class="mb-12">
				<div
					class="group relative grid gap-4 pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:hover:opacity-100! lg:group-hover/list:opacity-50"
				>
					<div
						class="absolute -inset-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-slate-800/50 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] lg:group-hover:drop-shadow-lg"
					/>
					<div class="z-10 sm:order-2 sm:col-span-6">
						<h3>
							<a
								href={project.deployUrl}
								target="_blank"
								rel="noreferrer noopener"
								aria-label={`${project.name} (opens in new page)`}
								class="inline-flex items-baseline font-medium leading-tight text-slate-200 group/link text-base"
							>
								<span
									class="absolute -inset-x-4 -inset-y-2.5 hidden rounded md:-inset-x-6 md:-inset-y-4 lg:block"
								/>
								{project.name} <Arrow />
							</a>
						</h3>
						<p>{project.description}</p>
						<ul class="mt-2 flex flex-wrap" aria-label="Technologies used">
							{project.technologies.map((technology) => (
								<li class="mr-1.5 mt-2 flex items-center rounded-full bg-teal-400/10 px-3 py-1 text-xs/5 font-medium text-teal-300">
									{technology}
								</li>
							))}
						</ul>
					</div>
					<img
						loading="lazy"
						width="200"
						height="48"
						decoding="async"
						alt="img"
						class="aspect-video object-cover rounded border-2 border-slate-200/10 transition group-hover:border-slate-200/30 sm:order-1 sm:col-span-2 sm:translate-y-1"
						style="color: transparent"
						src={project.imgSrc}
					>
				</div>
			</li>
		))}
	</ul>
</Section>
