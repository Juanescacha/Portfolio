---
import Section from "@/components/sections/Section.astro"
import Arrow from "@/components/ui/Arrow.astro"
import { profile, sections } from "@/data"
---

<Section title={sections.about} ariaLabel="About me">
	{profile.about.map((paragraph) => (
		<p class="mb-4">{paragraph}</p>
	))}
	<div class="mt-12">
		<a
			href="/Juan_Camargo_Resume.pdf"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="View Full Resume (opens in a new tab)"
			class="inline-block items-baseline leading-tight font-semibold text-slate-200 group/link text-base"
		>
			View Full Resume
			<Arrow />
		</a>
	</div>
</Section>
