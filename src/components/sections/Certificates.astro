---
import { Image } from "astro:assets"
import Section from "@/components/sections/Section.astro"
import Arrow from "@/components/ui/Arrow.astro"
import { getContent } from "@/data"

const { certificates, sections, ui } = getContent(Astro.currentLocale)
---

<Section title={sections.certificates} ariaLabel={ui.ally.selectedCertificates}>
	<ul class="group/list">
		{certificates.map((certificate) => (
				<li class="mb-12">
					<div
							class="group relative grid gap-4 pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:hover:opacity-100! lg:group-hover/list:opacity-50"
					>
						<div
								class="absolute -inset-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-surface lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] lg:group-hover:drop-shadow-lg"
						/>
						<div class="z-10 sm:order-2 sm:col-span-6">
							<h3>
								<a
										href={certificate.url}
										target="_blank"
										rel="noreferrer noopener"
										aria-label={`${certificate.name} (${ui.ally.opensInNewTab})`}
										class="items-baseline font-medium leading-tight text-primary group/link text-base"
								>
								<span
										class="absolute -inset-x-4 -inset-y-2.5 hidden rounded md:-inset-x-6 md:-inset-y-4 lg:block"
								/>
									{certificate.name} <Arrow />
								</a>
							</h3>
							<p class="text-sm mt-2 leading-normal text-foreground">{certificate.issuer}</p>
							<p class="text-sm mt-2 leading-normal text-foreground">{certificate.date.month} {certificate.date.year}</p>
						</div>
						<Image
								src={certificate.imgSrc}
								alt={certificate.name}
								layout="constrained"
								class="aspect-video object-cover rounded border-2 border-border transition group-hover:border-border-strong sm:order-1 sm:col-span-2 sm:translate-y-1"
						/>
					</div>
				</li>
		))}
	</ul>
</Section>
